{
  "appId": "com.biscord.desktop",
  "productName": "vulcord",
  "directories": {
    "output": "desktop-release-vulcord"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/server.json",
    "package.json",
    "desktop/navigation.cjs"
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs",
    "name": "biscord"
  },
  "win": {
    "target": [
      "portable"
    ],
    "icon": "branding/assets/vulcord.ico",
    "signExecutable": false
  },
  "portable": {
    "artifactName": "vulcord-${version}-Windows.exe"
  }
}
