# Loaded automatically by npm start (Node.js 24+).
PORT=4173
# Optional absolute directory. Default: ./data
# BISCORD_DATA_DIR=
# Set true only when serving through HTTPS.
COOKIE_SECURE=false
# Password-recovery mail is disabled until SMTP and the public base URL are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESET_BASE_URL=http://127.0.0.1:4173
# PostgreSQL (Supabase Session pooler). Empty keeps the local SQLite database.
DATABASE_URL=
SUPABASE_PROJECT_REF=
# HTTPS public URL assigned by ngrok; enables Secure cookies automatically.
PUBLIC_ORIGIN=
# Optional local path to the database CA certificate; TLS verification stays enabled.
PGSSLROOTCERT=

# Vercel frontend + backend on this PC (npm run start:local-internet)
# The frontend origin, NOT the tunnel URL:
# PUBLIC_ORIGIN=https://biscord-ashy.vercel.app
# Public HTTPS tunnel URL, used ONLY to prepare the Vercel routing package:
BISCORD_API_ORIGIN=
# This local mode always uses SQLite in BISCORD_DATA_DIR (default ./data).
